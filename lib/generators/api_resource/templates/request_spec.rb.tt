require "rails_helper"

RSpec.describe "<%= plural_class_name %>", type: :request do
  let(:user) { create(:user) }
  let(:headers) { auth_headers(user) }
  let(:others) { create(:<%= file_name %>) }
  let(:valid_params) { { <%= attributes.map { |attribute| "#{attribute.name}: #{sample(attribute)}" }.join(", ") %> } }
  let(:invalid_params) { { <%= required_attributes.first.name %>: "" } }

  it "requires authentication" do
    get "/api/v1/<%= plural_table_name %>"
    expect(response).to have_http_status(:unauthorized)
  end

  describe "POST /api/v1/<%= plural_table_name %>" do
    it "creates a record owned by the current user, ignoring any user_id sent" do
      post "/api/v1/<%= plural_table_name %>", params: valid_params.merge(user_id: others.user_id), headers: headers, as: :json

      expect(response).to have_http_status(:created)
      expect(json["data"]).not_to have_key("user_id")
      expect(<%= class_name %>.find(json.dig("data", "id")).user).to eq(user)
    end

    it "returns per-field errors" do
      post "/api/v1/<%= plural_table_name %>", params: invalid_params, headers: headers, as: :json

      expect(response).to have_http_status(:unprocessable_content)
      expect(json.dig("error", "details", "<%= required_attributes.first.name %>", 0, "code")).to eq("blank")
    end
  end

  describe "GET /api/v1/<%= plural_table_name %>" do
    it "lists only the user's records, newest first, paginated" do
      older = create(:<%= file_name %>, user: user, created_at: 1.day.ago)
      newer = create(:<%= file_name %>, user: user)
      others

      get "/api/v1/<%= plural_table_name %>", params: { limit: 1 }, headers: headers

      expect(response).to have_http_status(:ok)
      expect(json["data"].map { |record| record["id"] }).to eq([ newer.id ])
      expect(json["meta"]).to include("total" => 2, "next" => 2)

      get "/api/v1/<%= plural_table_name %>", params: { page: 2, limit: 1 }, headers: headers
      expect(json["data"].map { |record| record["id"] }).to eq([ older.id ])
    end
  end

  describe "a single record" do
    let(:<%= file_name %>) { create(:<%= file_name %>, user: user) }

    it "shows the owner's record" do
      get "/api/v1/<%= plural_table_name %>/#{<%= file_name %>.id}", headers: headers
      expect(response).to have_http_status(:ok)
      expect(json.dig("data", "id")).to eq(<%= file_name %>.id)
    end

    it "updates with PATCH and PUT" do
      patch "/api/v1/<%= plural_table_name %>/#{<%= file_name %>.id}", params: valid_params, headers: headers, as: :json
      expect(response).to have_http_status(:ok)

      put "/api/v1/<%= plural_table_name %>/#{<%= file_name %>.id}", params: valid_params, headers: headers, as: :json
      expect(response).to have_http_status(:ok)
    end

    it "rejects an invalid update" do
      patch "/api/v1/<%= plural_table_name %>/#{<%= file_name %>.id}", params: invalid_params, headers: headers, as: :json
      expect(response).to have_http_status(:unprocessable_content)
    end

    it "deletes the owner's record" do
      delete "/api/v1/<%= plural_table_name %>/#{<%= file_name %>.id}", headers: headers
      expect(response).to have_http_status(:no_content)
      expect(<%= class_name %>.exists?(<%= file_name %>.id)).to be(false)
    end
  end

  it "answers 404 for another user's record, even to admins" do
    get "/api/v1/<%= plural_table_name %>/#{others.id}", headers: headers
    expect(response).to have_http_status(:not_found)

    patch "/api/v1/<%= plural_table_name %>/#{others.id}", params: valid_params, headers: headers, as: :json
    expect(response).to have_http_status(:not_found)

    delete "/api/v1/<%= plural_table_name %>/#{others.id}", headers: headers
    expect(response).to have_http_status(:not_found)

    get "/api/v1/<%= plural_table_name %>/#{others.id}", headers: auth_headers(create(:user, :admin))
    expect(response).to have_http_status(:not_found)
  end
end
